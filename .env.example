# Copy this file to .env and fill in your values.
# The app reads these automatically when running locally.

# PostgreSQL connection string (required)
# Create a local database: createdb ozy_sneakers
DATABASE_URL=postgresql://localhost:5432/ozy_sneakers

# Groq API key (required for chatbot) — get yours at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Cartesia TTS key (required for voice chatbot replies) — get yours at dashboard.cartesia.com
CARTESIA_API_KEY=your_cartesia_api_key_here
# CARTESIA_MODEL_ID=sonic-3          (default)
# CARTESIA_VOICE_ID=47c38ca4-...     (default: Daniel - Modern Assistant)
# CARTESIA_LANGUAGE=hi               (default: hi for Hinglish)

# Resend API key (required for contact form emails) — get yours at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_EMAIL=anujror202007@gmail.com   (where contact forms are sent)

# Optional: override the default ports
# API_PORT=3000      (default: 3000)
# PORT=5173          (default: 5173, used by the frontend Vite server)
