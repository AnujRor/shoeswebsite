# Copy this file to .env and fill in your values.
# The app reads these automatically when running locally.

# PostgreSQL connection string (required)
# Create a local database: createdb ozy_sneakers
DATABASE_URL=postgresql://localhost:5432/ozy_sneakers

# Groq API key (required for chatbot) — get yours at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default ports
# API_PORT=3000      (default: 3000)
# PORT=5173          (default: 5173, used by the frontend Vite server)
